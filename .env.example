# 复制这个文件为 .env，填入你的 token
# cp .env.example .env

# HuggingFace token（从 https://huggingface.co/settings/tokens 获取）
export HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace 缓存统一放到共享存储（跨服务器共用，避免重复下载）
export HF_HOME=/mnt/gyc_ckp/hf_cache

# Wandb 团队/个人 entity（所有 run 强制落到这个账号下，避免不同机器 .netrc 不一致写错）
export WANDB_ENTITY=moruoguo5589
# Wandb API key（从 https://wandb.ai/authorize 获取；新机器没有 ~/.netrc 时必须设）
export WANDB_API_KEY=wandb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 代理设置（如需要）
http_proxy=http://192.168.32.28:18000
https_proxy=http://192.168.32.28:18000
